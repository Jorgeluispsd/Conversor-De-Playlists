# Copie este arquivo para ".env" e preencha com suas próprias credenciais.
# O ".env" real NUNCA deve ser commitado (já está no .gitignore).

# Criado em https://developer.spotify.com/dashboard (adicione seu e-mail em Users Management)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Criado no Google Cloud Console, com a YouTube Data API v3 ativada
YOUTUBE_API_KEY=
